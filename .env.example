# Sitenin herkese açık adresi (canonical, sitemap ve Open Graph için). Sonunda / olmadan.
# Vercel'de boş bırakılırsa projenin üretim alan adı kullanılır.
SITE_URL=http://localhost:3000

# PostgreSQL bağlantısı. Vercel'de Neon entegrasyonu DATABASE_URL ve DATABASE_URL_UNPOOLED
# değişkenlerini kendisi tanımlar. Boş bırakılırsa yerelde süreç içi PostgreSQL (PGlite) kullanılır.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Yerel PGlite veri klasörü. Boş bırakılırsa ./data/pglite kullanılır.
LOCAL_DB_DIR=

# Vercel Blob (private depo) erişim anahtarı. Blob deposu projeye bağlanınca Vercel tanımlar.
# Boş bırakılırsa görseller yerel diske (UPLOAD_DIR) yazılır.
BLOB_READ_WRITE_TOKEN=

# Yerel görsel klasörü. Boş bırakılırsa ./storage/uploads kullanılır.
UPLOAD_DIR=

# Oturum çerezinde Secure bayrağı. Production'da varsayılan true. Yalnızca HTTPS olmayan
# bir alan adında deneme yaparken false yapın; localhost için gerekmez.
COOKIE_SECURE=

# İstemci IP'si X-Forwarded-For başlığının en sağdaki değerinden okunur; giriş ve iletişim formu
# sınırları bu IP'ye göre uygulanır. Vercel'de kendiliğinden true kabul edilir. Kendi sunucunuzda
# bir ters vekil (Caddy, Nginx) arkasındaysanız true yapın; yerel geliştirmede boş bırakın.
TRUST_PROXY=

# Yalnızca "npm run admin:create" için, etkileşimsiz kurulumda. Kullandıktan sonra silin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
