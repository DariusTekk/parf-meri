# Sitenin herkese açık adresi (canonical, sitemap ve Open Graph için). Sonunda / olmadan.
SITE_URL=http://localhost:3000

# SQLite veritabanı dosyası. Boş bırakılırsa ./data/app.sqlite kullanılır.
DATABASE_PATH=

# Yüklenen görsellerin klasörü. Boş bırakılırsa ./storage/uploads kullanılır.
UPLOAD_DIR=

# Oturum çerezinde Secure bayrağı. Production'da varsayılan true. Yalnızca HTTPS olmayan
# bir alan adında deneme yaparken false yapın; localhost için gerekmez.
COOKIE_SECURE=

# Production'da uygulama bir ters vekil (Caddy, Nginx) arkasında çalışmalı ve bu değer true olmalıdır.
# İstemci IP'si X-Forwarded-For başlığının en sağdaki değerinden okunur; giriş ve iletişim formu
# sınırları bu IP'ye göre uygulanır. false iken tüm ziyaretçiler tek bir sınır kovasını paylaşır.
# Yerel geliştirmede false bırakın.
TRUST_PROXY=false

# Yalnızca "npm run admin:create" için, etkileşimsiz kurulumda. Kullandıktan sonra silin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
