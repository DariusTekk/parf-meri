{
  "name": "parfumeri",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts latest && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "migrate:latest": "tsx scripts/migrate.ts latest",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:check": "tsx scripts/migrate.ts check",
    "admin:create": "tsx scripts/admin-create.ts",
    "demo:load": "tsx scripts/demo.ts load",
    "demo:clear": "tsx scripts/demo.ts clear",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "secrets:scan": "tsx scripts/sir-tarama.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@node-rs/argon2": "2.2.2",
    "@vercel/blob": "2.8.2",
    "kysely": "0.29.8",
    "kysely-pglite-dialect": "1.4.0",
    "lucide-react": "1.70.0",
    "markdown-it": "15.0.3",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
